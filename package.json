{
  "name": "mapbox-mcp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "prepare": "node -e \"try { require('fs').accessSync('.husky/setup-hooks.js'); require('child_process').execSync('husky && node .husky/setup-hooks.js', {stdio:'inherit'}) } catch { }\""
  },
  "lint-staged": {
    "*.{js,md}": "prettier --write"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "none",
    "endOfLine": "lf"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "lint-staged": "^16.1.0",
    "prettier": "^3.0.0"
  }
}
